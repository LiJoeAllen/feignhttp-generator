{
  "openapi": "3.0.3",
  "info": { "title": "Vending Machine API", "version": "1.0.0" },
  "servers": [{ "url": "https://api.example.com/dmgt-api/v1" }],
  "paths": {
    "/health": {
      "get": {
        "operationId": "health",
        "responses": { "200": { "description": "ok" } }
      }
    },
    "/device-groups": {
      "get": {
        "operationId": "getDeviceGroups",
        "parameters": [
          { "name": "page", "in": "query", "required": true, "schema": { "type": "integer", "format": "int32" } },
          { "name": "pageSize", "in": "query", "required": true, "schema": { "type": "integer", "format": "int32" } }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/IndexGetDeviceGroupsResp" } } },
            "404": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorPayload" } } } }
          }
        }
      },
      "post": {
        "operationId": "createDeviceGroup",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeviceGroupCreate" } } } },
        "responses": {
          "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeviceGroup" } } } },
          "400": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorPayload" } } } }
        }
      }
    },
    "/device-groups/{groupId}/devices/{deviceId}/status": {
      "put": {
        "operationId": "updateDeviceStatus",
        "parameters": [
          { "name": "groupId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "deviceId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "X-Token", "in": "header", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeviceStatus" } } } },
        "responses": {
          "200": { "description": "ok" },
          "500": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorPayload" } } } }
        }
      },
      "patch": {
        "operationId": "partiallyUpdateDevice",
        "parameters": [
          { "name": "groupId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "deviceId", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/IndexPatchDeviceGroupsBody" } } } },
        "responses": {
          "200": { "description": "ok" },
          "500": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ApiErrorPayload" } } } }
        }
      }
    },
    "/device/login": {
      "post": {
        "operationId": "login",
        "requestBody": { "required": true, "content": { "application/x-www-form-urlencoded": { "schema": { "$ref": "#/components/schemas/DeviceLoginForm" } } } },
        "responses": { "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LoginResp" } } } } }
      }
    },
    "/device/firmware/{firmwareId}/download": {
      "get": {
        "operationId": "downloadFirmware",
        "parameters": [{ "name": "firmwareId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "binary", "content": { "application/octet-stream": { "schema": { "type": "string", "format": "binary" } } } } }
      }
    },
    "/device/{deviceId}/avatar": {
      "post": {
        "operationId": "uploadAvatar",
        "parameters": [{ "name": "deviceId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": { "type": "string", "format": "binary" },
                  "kind": { "type": "string" }
                },
                "required": ["file", "kind"]
              }
            }
          }
        },
        "responses": { "200": { "description": "ok", "content": { "text/plain": { "schema": { "type": "string" } } } } }
      }
    },
    "/inventory/{machineId}/slots/{slotNo}": {
      "head": {
        "operationId": "probeSlot",
        "parameters": [
          { "name": "machineId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "slotNo", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }
        ],
        "responses": { "200": { "description": "exists" } }
      },
      "options": {
        "operationId": "slotPreflight",
        "parameters": [
          { "name": "machineId", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "slotNo", "in": "path", "required": true, "schema": { "type": "integer", "format": "int64" } }
        ],
        "responses": { "200": { "description": "allowed" } }
      }
    },
    "/stats/daily/{date}": {
      "get": {
        "operationId": "dailyStats",
        "parameters": [
          { "name": "date", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "granularity", "in": "query", "required": false, "schema": { "type": "string", "enum": ["hour", "day"] } }
        ],
        "responses": { "200": { "description": "ok", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DailyStats" } } } } }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiErrorPayload": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "integer", "format": "int32" },
          "message": { "type": "string" },
          "traceId": { "type": "string" }
        }
      },
      "IndexGetDeviceGroupsResp": {
        "type": "object",
        "required": ["items", "total"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/DeviceGroup" } },
          "total": { "type": "integer", "format": "int64" }
        }
      },
      "DeviceGroup": {
        "type": "object",
        "required": ["groupId", "groupName"],
        "properties": {
          "groupId": { "type": "string" },
          "groupName": { "type": "string" },
          "capacity": { "type": "integer", "format": "int64" }
        }
      },
      "DeviceGroupCreate": {
        "type": "object",
        "required": ["groupName"],
        "properties": {
          "groupName": { "type": "string" },
          "capacity": { "type": "integer", "format": "int64" }
        }
      },
      "DeviceStatus": {
        "type": "object",
        "required": ["state"],
        "properties": {
          "state": { "type": "string", "enum": ["online", "offline", "maintenance"] },
          "temperature": { "type": "number", "format": "float" }
        }
      },
      "IndexPatchDeviceGroupsBody": {
        "type": "object",
        "properties": { "volume": { "type": "integer", "format": "int64" } }
      },
      "DeviceLoginForm": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string" },
          "password": { "type": "string" }
        }
      },
      "LoginResp": {
        "type": "object",
        "required": ["accessToken"],
        "properties": {
          "accessToken": { "type": "string" },
          "expiresIn": { "type": "integer", "format": "int64" }
        }
      },
      "DailyStats": {
        "type": "object",
        "required": ["date", "revenue"],
        "properties": {
          "date": { "type": "string" },
          "granularity": { "type": "string", "enum": ["hour", "day"] },
          "revenue": { "type": "number", "format": "double" },
          "transactions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["count", "slotNo"],
              "properties": {
                "count": { "type": "integer", "format": "int64" },
                "slotNo": { "type": "integer", "format": "int64" }
              }
            }
          }
        }
      }
    }
  }
}
